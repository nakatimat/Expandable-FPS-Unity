# Unity .gitignore
# Place at root of Unity project

# =============== #
# Unity Generated #
# =============== #
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
MemoryCaptures/
UserSettings/LocalSettings.asset
Assets/AssetStoreTools*/
Assets/Plugins/Editor/**/ImportSettings/

# Ignore Unity Editor Layouts (avoid conflicts for multi-dev teams)
UserSettings/Layouts/
UserSettings/Layouts-default/
UserSettings/EditorUserSettings.asset
UserSettings/Editor/EditorUserSettings.asset

# Uncomment if using Unity cache server
# Library/com.unity.collab/proxy

# ===================================== #
# OS Generated / IDE / Editor files      #
# ===================================== #

# Windows
Thumbs.db
desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.suo
*.sln.docstates
*.user
*.userprefs
*.csproj
*.unityproj
*.sln
*.sdf
*.dbmdl
*.opendb
*.VC.db
*.pidb
*.pidb.meta
*.pdb
*.mdb
*.opendb
[Bb]in/
[Oo]bj/
*.userosscache
*.sln.iml

# JetBrains Rider
.idea/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/dictionaries
.idea/**/shelf

# MonoDevelop / Xamarin Studio
*.userprefs

# ====================== #
# Compiled / Build files #
# ====================== #
*.apk
*.aab
*.unitypackage
*.app
*.xcodeproj/
*.xcworkspace/
*.xcuserdata/
*.ipa
*.obb

# ====================== #
# Temporary / backup     #
# ====================== #
*.tmp
*.temp
*.bak
*.swp
*.orig
*.log
*.log.*
*.stacktrace

# ====================== #
# Package Managers       #
# ====================== #
node_modules/
.npm/
.yarn/
.pnpm-store/
.npmrc

# ====================== #
# Test results / coverage #
# ====================== #
TestResults/
*.coverage
*.coveragexml

# ====================== #
# Unity Cloud Build       #
# ====================== #
*.mobileprovision
*.jks

# ====================== #
# LFS / large files       #
# ====================== #
# Use .gitattributes for tracking
# Example:
# *.png filter=lfs diff=lfs merge=lfs -text

# Keep ProjectSettings tracked, but ignore local-only locks
ProjectSettings/ProjectSettings.asset.lock
ProjectSettings/EditorBuildSettings.asset.lock
ProjectSettings/NetworkManager.asset.lock

# Local editor configs (per-user)
ProjectSettings/EditorSettings.asset
ProjectSettings/EditorBuildSettings.asset
ProjectSettings/TimeManager.asset
ProjectSettings/GraphicsSettings.asset

# ====================== #
# Misc                    #
# ====================== #
*.swf
*.psd.meta
*.tga.meta

# Ignore crash reports
crash.dmp

# End of file